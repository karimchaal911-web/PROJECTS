{
  "name": "map-soluble-soutenance-claude",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "capture": "node scripts/capture-scenes.mjs",
    "capture:offline": "node scripts/capture-scenes.mjs --offline --out ../exports/offline_check",
    "record": "node scripts/record-tour.mjs",
    "probe": "node scripts/probe.mjs",
    "perf": "node scripts/qa-perf.mjs",
    "restore": "node scripts/qa-restore.mjs",
    "channels": "node scripts/qa-channels.mjs",
    "qa": "npm run build && npm run capture && npm run capture:offline && npm run channels && python ../data_build/qa_checks.py",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^24.43.1",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  },
  "description": "Presenter-controlled cinematic 3D soutenance for the OCP soluble MAP dryer digitalization project. Runs offline."
}
