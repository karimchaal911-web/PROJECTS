DB_HOST=localhost
DB_PORT=5432
DB_NAME=MAP_DRYER
DB_USER=postgres
DB_PASSWORD=password

SOURCE_CSV=data/dryerMAP_dashboard_1min_original_features_only.csv
REPLAY_INTERVAL_SECONDS=60

ANOMALY_MODEL=../models/anomaly_pipeline/anomaly_pipeline.joblib
ANOMALY_SCALER=../models/anomaly_pipeline/anomaly_scaler.joblib
MOISTURE_MODEL=../models/moisture_pipeline/moisture_pipeline.joblib
REFERENCE_PROFILE=../models/anomaly_pipeline/reference_profile.json

# --- 5-second real-time service (realtime_service.py) ---
# REPLAY_SPEED: 1 = real time, 60 = 60x accelerated, 0 = as fast as possible
SOURCE_CSV_5S=../data/raw/MAP_Dryer_Canonical_5s_deterministic.csv
SOURCE_PARTITION_5S=held_out_test
REPLAY_START_TIMESTAMP=2026-07-03 06:00:00
MODELS_5S_DIR=../models/5s
POLL_INTERVAL_SECONDS=5
REPLAY_SPEED=1
MAX_CYCLES=0
EXIT_WHEN_EXHAUSTED=true
STALE_AFTER_SECONDS=30
TRANSPORT_DELAY_MINUTES=0
REPLAY_FROM_START=false
