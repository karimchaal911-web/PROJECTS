# Copy this file to realtime_pipeline/.env and fill in the local values.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=MAP_DRYER
DB_USER=postgres
DB_PASSWORD=change-me

# --- Supported service: five-second replay (realtime_service.py) --------
# This is what RUN_FINAL_DEMO.ps1 starts and what the Power BI dashboard reads.
SOURCE_CSV_5S=../resources/dashboard_demo/MAP_Dryer_Dashboard_Demo_5s.csv
WARMUP_CSV_5S=../resources/dashboard_demo/MAP_Dryer_Dashboard_Warmup_5s.csv
SOURCE_PARTITION_5S=dashboard_demo
MODELS_5S_DIR=../models/5s
REPLAY_START_TIMESTAMP=
POLL_INTERVAL_SECONDS=5
# REPLAY_SPEED: 1 = real time, 60 = 60x accelerated, 0 = as fast as possible
REPLAY_SPEED=1
MAX_CYCLES=0
EXIT_WHEN_EXHAUSTED=true
REPLAY_FROM_START=false
STALE_AFTER_SECONDS=30
# Extra lag added after residence time when selecting the process window.
TRANSPORT_DELAY_MINUTES=0

# --- Legacy one-minute replay (replay_service.py) -----------------------
# Superseded by realtime_service.py and incompatible with the five-second
# dashboard schema. Kept for reference only. MOISTURE_MODEL is written by
# Notebook 03 (models/moisture_pipeline/), so it does not exist in a fresh
# clone until the notebooks have been run.
# replay_service.py refuses to start unless this is explicitly true.
ENABLE_LEGACY_1MIN_REPLAY=false
SOURCE_CSV=data/dryerMAP_dashboard_1min_original_features_only.csv
REPLAY_INTERVAL_SECONDS=60
ANOMALY_MODEL=../models/anomaly_pipeline/anomaly_pipeline.joblib
ANOMALY_SCALER=../models/anomaly_pipeline/anomaly_scaler.joblib
MOISTURE_MODEL=../models/moisture_pipeline/moisture_pipeline.joblib
REFERENCE_PROFILE=../models/anomaly_pipeline/reference_profile.json
