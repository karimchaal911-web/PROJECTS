# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# JavaScript dependencies are restored from package-lock.json.
**/node_modules/

# Local browser/build scratch workspaces are not project deliverables.
/tmp/

# --- data ---------------------------------------------------------------
# The expanded 92-day CSVs (235 MB each) and the held-out replay stay local.
# The canonical dataset is user-supplied and deterministic - nothing in this
# repository regenerates it - so it is versioned as an XZ archive instead, and
# restored by tools/restore_canonical_dataset.py. The compact manifest and the
# Notebook 02 handoff stay visible so the modelling notebooks and the runtime
# contract can be rerun from a clone.
/data/raw/*
/data/processed/*
!/data/raw/MAP_Dryer_Canonical_5s_deterministic.csv.xz
!/data/processed/MAP_Dryer_Canonical_5s.manifest.json
!/data/processed/MAP_Dryer_Lab_Aligned_16.csv

# --- models -------------------------------------------------------------
# Candidate and legacy estimators are reproducible notebook outputs.
/models/**/*.pkl
/models/**/*.joblib

# The three artifacts the five-second runtime loads are versioned, because
# RUN_FINAL_DEMO.ps1 deliberately never retrains or executes notebooks.
!/models/5s/quality_moisture_pipeline.joblib
!/models/5s/anomaly_model.joblib
!/models/5s/anomaly_scaler.joblib

# Keep compact model metadata visible despite the parent workspace's broad
# models ignore rule.
!/models/5s/
!/models/5s/*.json
!/models/model_metadata.json
!/models/model_registry.json
!/models/prototype_manifest.json

# --- final report -------------------------------------------------------
# LaTeX intermediates and the out-of-tree build directory are regenerated by
# the documented build; the shipped PDF is MAP_Dryer_AI_Internship_Report.pdf.
/final_report/build/
/final_report/main.pdf
/final_report/*.aux
/final_report/*.lof
/final_report/*.log
/final_report/*.lot
/final_report/*.out
/final_report/*.toc
/final_report/*.fls
/final_report/*.fdb_latexmk
/final_report/*.synctex.gz

# Local environment files. Keep the checked-in template visible.
.env
.env.*
!.env.example

# Editor, OS, log and temporary clutter
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.temp
*.bak

# Power BI Desktop local state (never contains report/model source).
# Credentials live in Power BI's credential store, not in the repository.
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/*.pbix.bak

# --- final_presentation (soutenance build) -----------------------
# Build output, dependencies, video render frames and transient capture
# rounds are reproducible from web/ and data_build/.
final_presentation/web/node_modules/
final_presentation/web/dist/
final_presentation/exports/video/
final_presentation/exports/offline_check/
final_presentation/*.mp4

# Transfer archive is reproducible from final_presentation/ and exceeds
# the practical size of a normal Git source commit.
/FINAL_MAP_Soluble_Digitalization_Soutenance_DELIVERY.zip
