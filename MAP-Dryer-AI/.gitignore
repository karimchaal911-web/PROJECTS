# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Keep only the datasets required by the four-notebook pipeline.
/data/raw/*
!/data/raw/dryerMAP_prototype_2.xlsx
/data/processed/*
!/data/processed/dryerMAP_prototype_deduplicated_2.xlsx
!/data/processed/dryerMAP_prototype_processed_2.csv

# Serialized estimators are reproducible notebook outputs.
/models/**/*.pkl
/models/**/*.joblib

# Local environment files
.env
.DS_Store
Thumbs.db

# Power BI Desktop local state (never contains report/model source).
# Credentials live in Power BI's credential store, not in the repository.
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/*.pbix.bak
