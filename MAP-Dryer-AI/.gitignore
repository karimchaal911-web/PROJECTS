# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Data and model artefacts
# Version the four prototype datasets required to run the notebooks. Keep any
# future raw or processed operational data ignored unless explicitly approved.
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/dryerMAP_original.xlsx
!/data/raw/dryerMAP_prototype.xlsx
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/dryerMAP_prototype_deduplicated.xlsx
!/data/processed/dryerMAP_prototype_processed.csv
/models/**/*.pkl
/models/**/*.joblib
/models/**/*.json

# Outputs
/figures/*
!/figures/.gitkeep
!/figures/*/
!/figures/*/.gitkeep
/reports/*
!/reports/.gitkeep

# Environment
.env
.DS_Store
Thumbs.db
