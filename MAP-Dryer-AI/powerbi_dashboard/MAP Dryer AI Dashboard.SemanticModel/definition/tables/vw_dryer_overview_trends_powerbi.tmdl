/// Lightweight process/model trend restricted by SQL to the
/// latest eight hours. It intentionally omits the expensive laboratory as-of
/// lookup used by the KPI view and has no model relationship, so overview
/// chart selections cannot change current-state cards.
table vw_dryer_overview_trends_powerbi
	lineageTag: a8c62ac1-9a10-5796-8848-113ffe9f9da1

	measure 'Overview Predicted Moisture' = AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Predicted Final Moisture] )
		formatString: 0.000000
		displayFolder: 12 Trend Series (5s)
		lineageTag: bed63241-de8f-5b08-96ce-f5d063fb7a5f

	measure 'Overview Lab Markers' = AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Laboratory Moisture] )
		formatString: 0.000000
		displayFolder: 12 Trend Series (5s)
		lineageTag: 4cb3aeaa-bf2e-556d-8559-6ec8ae5efc75

	measure 'Overview Predicted Moisture (Anomalous)' =
			CALCULATE (
			    AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Predicted Final Moisture] ),
			    'vw_dryer_overview_trends_powerbi'[Anomaly Detected] = TRUE ()
			)
		formatString: 0.000000
		displayFolder: 12 Trend Series (5s)
		lineageTag: ddcff217-f719-5afe-9877-fd89b57a3b6c

	measure 'Overview Target Band Low' = 0.07018
		formatString: 0.00000
		displayFolder: 12 Trend Series (5s)
		lineageTag: b8b036ec-5f32-5539-8912-b94c9875c3ac

	measure 'Overview Target Band High' = 0.08074
		formatString: 0.00000
		displayFolder: 12 Trend Series (5s)
		lineageTag: 98348bea-b2e4-5698-ace6-106990306ce0

	measure 'Overview Dryer Air Temperature' = AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Dryer Air Temperature] )
		formatString: 0.0
		displayFolder: 12 Trend Series (5s)
		lineageTag: f170078c-d005-5236-b537-24b04e79b80b

	measure 'Overview Wet Feed Rate' = AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Wet Product Feed Rate] )
		formatString: 0.0
		displayFolder: 12 Trend Series (5s)
		lineageTag: d5248494-8a4b-52f2-a1a3-b88fcda0a741

	measure 'Overview Steam Pressure' = AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Steam Pressure] )
		formatString: 0.00
		displayFolder: 12 Trend Series (5s)
		lineageTag: 697e1400-0900-575a-aba4-e366b4806654

	measure 'Overview Air Flow Rate' = AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Air Flow Rate] )
		formatString: #,0
		displayFolder: 12 Trend Series (5s)
		lineageTag: d0053a70-ba7c-5d14-968b-8bfcbac1e61d

	measure 'Overview Vacuum' = AVERAGE ( 'vw_dryer_overview_trends_powerbi'[Vacuum] )
		formatString: 0.0
		displayFolder: 12 Trend Series (5s)
		lineageTag: 7fd3e8d4-6f79-59b1-8b0e-0d184378da04

	column Timestamp
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 9915f27a-dd9e-5e15-ade3-138e0acd6dc1
		summarizeBy: none
		sourceColumn: Timestamp

	column 'Predicted Final Moisture'
		dataType: double
		formatString: 0.000000
		lineageTag: 63e96efa-b28f-5bbf-8633-532288b12cb1
		summarizeBy: none
		sourceColumn: Predicted Final Moisture

	column 'Laboratory Moisture'
		dataType: double
		formatString: 0.000000
		lineageTag: 1f8b4b4e-ae70-532e-8370-a333f4f433ea
		summarizeBy: none
		sourceColumn: Laboratory Moisture

	column 'Anomaly Risk'
		dataType: double
		formatString: 0.000
		lineageTag: c5fe184e-4324-5dd3-983d-c861d270d114
		summarizeBy: none
		sourceColumn: Anomaly Risk

	column 'Anomaly Detected'
		dataType: boolean
		lineageTag: d18bde51-0805-55ff-9726-01f6f81fdaba
		summarizeBy: none
		sourceColumn: Anomaly Detected

	column 'Dryer Air Temperature'
		dataType: double
		formatString: 0.0
		lineageTag: 7104864c-ea25-5d55-acb7-0c367b3e6458
		summarizeBy: none
		sourceColumn: Dryer Air Temperature

	column 'Wet Product Feed Rate'
		dataType: double
		formatString: 0.0
		lineageTag: 5266001d-edd5-5cda-9780-e12a3ad152e3
		summarizeBy: none
		sourceColumn: Wet Product Feed Rate

	column 'Steam Pressure'
		dataType: double
		formatString: 0.00
		lineageTag: dce86b1c-5274-50ee-8e48-153e7b4a7fb3
		summarizeBy: none
		sourceColumn: Steam Pressure

	column 'Air Flow Rate'
		dataType: double
		formatString: #,0
		lineageTag: 4768cd33-3207-5af9-82ae-a722f111afae
		summarizeBy: none
		sourceColumn: Air Flow Rate

	column Vacuum
		dataType: double
		formatString: 0.0
		lineageTag: 5f2401ee-31ac-5ee2-8695-6d59b7c43e82
		summarizeBy: none
		sourceColumn: Vacuum

	partition vw_dryer_overview_trends_powerbi = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DB_Server, DB_Database),
				    Data = Source{[Schema = "public", Item = "vw_dryer_overview_trends_powerbi"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

