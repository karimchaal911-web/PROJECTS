/// One-row DirectQuery snapshot for live KPI cards. Keeping current-state
/// measures on this view avoids rescanning the full dashboard history for
/// every card during page load and automatic refresh.
table vw_dryer_latest
	lineageTag: 75b2d144-3700-4f86-bdb1-b54c4249784c

	column Timestamp
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
