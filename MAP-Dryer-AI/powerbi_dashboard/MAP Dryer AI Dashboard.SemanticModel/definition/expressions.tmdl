/// PostgreSQL server, entered as host:port. Change only this parameter (and
/// DB_Database below) when the database runs on another machine.
expression DB_Server = "localhost:5432" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 43dd09c3-f294-4f3f-b468-3d93cd5e7598

	annotation PBI_ResultType = Text

/// PostgreSQL database name discovered from realtime_pipeline/.env.example.
expression DB_Database = "MAP_DRYER" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 74b80ae9-889d-44c6-b4c1-daf2a810d413

	annotation PBI_ResultType = Text

