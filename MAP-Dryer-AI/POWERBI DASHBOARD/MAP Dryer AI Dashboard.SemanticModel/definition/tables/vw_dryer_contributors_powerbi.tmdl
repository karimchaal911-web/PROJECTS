/// Ranked abnormal process variables (0-4 rows per anomalous timestamp)
/// produced by the realtime_pipeline diagnosis engine. Filtered through the
/// one-to-many Timestamp relationship from vw_dryer_dashboard_powerbi.
table vw_dryer_contributors_powerbi

	measure 'Contributor Count' = COUNTROWS ( 'vw_dryer_contributors_powerbi' )
		formatString: #,0
		displayFolder: 06 Diagnostics Page

	measure 'Contributor Empty State' =
			IF (
			    COALESCE ( [Contributor Count], 0 ) = 0,
			    "No abnormal contributors recorded for this selection.",
			    ""
			)
		displayFolder: 06 Diagnostics Page

	measure 'Contributor Bar Color' =
			SWITCH (
			    UPPER ( MAX ( 'vw_dryer_contributors_powerbi'[Variable Severity] ) ),
			    "HIGH", "#C8102E",
			    "#E8A013"
			)
		displayFolder: 05 State Colors

	measure 'Contribution Score Value' = AVERAGE ( 'vw_dryer_contributors_powerbi'[Contribution Score] )
		formatString: 0.0000
		displayFolder: 07 Chart Series

	measure 'Contributor Rank Value' = MIN ( 'vw_dryer_contributors_powerbi'[Contributor Rank] )
		formatString: 0
		displayFolder: 07 Chart Series

	column Timestamp
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		summarizeBy: none
		sourceColumn: Timestamp

	column 'Contributor Rank'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Contributor Rank

	column 'Contributor Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Contributor Name

	column 'Observed Value'
		dataType: double
		formatString: 0.0000
		summarizeBy: none
		sourceColumn: Observed Value

	column 'Signed Deviation'
		dataType: double
		formatString: +0.0000;-0.0000;0.0000
		summarizeBy: none
		sourceColumn: Signed Deviation

	column 'Deviation Percent'
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: Deviation Percent

	column 'Contribution Score'
		dataType: double
		formatString: 0.0000
		summarizeBy: none
		sourceColumn: Contribution Score

	column 'Deviation Direction'
		dataType: string
		summarizeBy: none
		sourceColumn: Deviation Direction

	column 'Variable Severity'
		dataType: string
		summarizeBy: none
		sourceColumn: Variable Severity

	partition vw_dryer_contributors_powerbi = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DB_Server, DB_Database),
				    Data = Source{[Schema = "public", Item = "vw_dryer_contributors_powerbi"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
