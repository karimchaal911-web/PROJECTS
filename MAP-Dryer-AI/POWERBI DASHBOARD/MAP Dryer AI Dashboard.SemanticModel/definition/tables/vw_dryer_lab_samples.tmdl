/// Actual laboratory samples (one row per real analysis) with the
/// validated model prediction at each sample. Populated by the SQL view
/// vw_dryer_lab_samples; row count equals laboratory analyses, never
/// process rows.
table vw_dryer_lab_samples
	lineageTag: 0078eeb6-e612-51b1-9473-47690be47348

	measure 'Lab Sample Count' = COUNTROWS ( 'vw_dryer_lab_samples' )
		formatString: #,0
		displayFolder: 08 Lab Context (5s)
		lineageTag: 65868ce3-e8d4-5d0f-bd31-2f649b599735

	measure 'Lab MAE (Window)' = AVERAGE ( 'vw_dryer_lab_samples'[Validated Absolute Error] )
		formatString: 0.0000
		displayFolder: 09 Validation (5s)
		lineageTag: ded8635b-725e-58bf-b833-ae6b243d6bc3

	column 'Sample Timestamp'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 9b20df8e-d81a-51f9-9e46-2d494e80a4f7
		summarizeBy: none
		sourceColumn: Sample Timestamp

	column 'Product Density'
		dataType: double
		formatString: 0.0000
		lineageTag: 39734763-2b9d-5c03-bc1f-db82b79005aa
		summarizeBy: none
		sourceColumn: Product Density

	column 'Final Product Temp'
		dataType: double
		formatString: 0.0
		lineageTag: 0f5e91c2-8145-52ee-97d2-03db67166a3c
		summarizeBy: none
		sourceColumn: Final Product Temp

	column 'Laboratory Moisture'
		dataType: double
		formatString: 0.0000
		lineageTag: c8e3a0db-535d-5563-9b6a-069d4f91018b
		summarizeBy: none
		sourceColumn: Laboratory Moisture

	column 'Predicted Moisture At Sample'
		dataType: double
		formatString: 0.0000
		lineageTag: b26edb24-46a1-5e54-94aa-bae54ce547c7
		summarizeBy: none
		sourceColumn: Predicted Moisture At Sample

	column 'Validated Error'
		dataType: double
		formatString: +0.0000;-0.0000;0.0000
		lineageTag: cd3a6f3c-b945-5b93-ae38-ea8b9a3fbb9b
		summarizeBy: none
		sourceColumn: Validated Error

	column 'Validated Absolute Error'
		dataType: double
		formatString: 0.0000
		lineageTag: a3942e50-f9c5-588c-92e0-91636b69430f
		summarizeBy: none
		sourceColumn: Validated Absolute Error

	column 'Previous Sample Timestamp'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		isHidden
		lineageTag: 767c8a03-505d-52e6-a8f5-eb5c2146e5fd
		summarizeBy: none
		sourceColumn: Previous Sample Timestamp

	partition vw_dryer_lab_samples = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DB_Server, DB_Database),
				    Data = Source{[Schema = "public", Item = "vw_dryer_lab_samples"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
