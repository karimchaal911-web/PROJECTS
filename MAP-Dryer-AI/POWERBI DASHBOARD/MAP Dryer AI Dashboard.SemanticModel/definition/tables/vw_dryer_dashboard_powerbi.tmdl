	measure 'Lab Last Sample Timestamp' = CALCULATE ( MAX ( 'vw_dryer_lab_samples'[Sample Timestamp] ), REMOVEFILTERS ( 'vw_dryer_lab_samples' ) )
		formatString: yyyy-mm-dd hh:nn:ss
		displayFolder: 08 Lab Context (5s)
		lineageTag: 63767644-8824-5e22-bb3b-e87f558f6941

	measure 'Lab Last Moisture' =
			VAR t = [Lab Last Sample Timestamp]
			RETURN
			    CALCULATE (
			        AVERAGE ( 'vw_dryer_lab_samples'[Laboratory Moisture] ),
			        REMOVEFILTERS ( 'vw_dryer_lab_samples' ),
			        'vw_dryer_lab_samples'[Sample Timestamp] = t
			    )
		formatString: 0.0000
		displayFolder: 08 Lab Context (5s)
		lineageTag: 2b0d5a94-adf3-5a71-8635-b30a3a898c2c

	measure 'Lab Last Moisture Display' = IF ( ISBLANK ( [Lab Last Moisture] ), "—", FORMAT ( [Lab Last Moisture], "0.00" ) & " %" )
		displayFolder: 08 Lab Context (5s)
		lineageTag: 4f58bf9b-b747-5b27-8a17-21ac63143c77

	measure 'Lab Result Age Minutes' =
			IF (
			    ISBLANK ( [Lab Last Sample Timestamp] ) || ISBLANK ( [Latest Timestamp] ),
			    BLANK (),
			    DATEDIFF ( [Lab Last Sample Timestamp], [Latest Timestamp], SECOND ) / 60.0
			)
		formatString: 0.0
		displayFolder: 08 Lab Context (5s)
		lineageTag: 636ab98b-46f4-523a-a81e-a8b53581b108

	measure 'Lab Age Display' = IF ( ISBLANK ( [Lab Result Age Minutes] ), "no laboratory result", "Lab age " & FORMAT ( [Lab Result Age Minutes], "0" ) & " min" )
		displayFolder: 08 Lab Context (5s)
		lineageTag: 448e74f6-dad3-528a-af0a-5d87ed2248b5

	measure 'Lab Sample Time Display' = IF ( ISBLANK ( [Lab Last Sample Timestamp] ), "—", "Sampled " & FORMAT ( [Lab Last Sample Timestamp], "hh:nn" ) & " · " & FORMAT ( [Lab Result Age Minutes], "0" ) & " min ago" )
		displayFolder: 08 Lab Context (5s)
		lineageTag: 81360537-cc78-5299-987f-b15c887db106

	measure 'Validated Error Timestamp' =
			CALCULATE (
			    MAX ( 'vw_dryer_lab_samples'[Sample Timestamp] ),
			    REMOVEFILTERS ( 'vw_dryer_lab_samples' ),
			    NOT ISBLANK ( 'vw_dryer_lab_samples'[Validated Absolute Error] )
			)
		formatString: yyyy-mm-dd hh:nn:ss
		displayFolder: 09 Validation (5s)
		lineageTag: 001572da-678b-59c5-bbc6-8512f97f0062

	measure 'Validated Error Latest' =
			VAR t = [Validated Error Timestamp]
			RETURN
			    IF (
			        ISBLANK ( t ),
			        BLANK (),
			        CALCULATE (
			            AVERAGE ( 'vw_dryer_lab_samples'[Validated Absolute Error] ),
			            REMOVEFILTERS ( 'vw_dryer_lab_samples' ),
			            'vw_dryer_lab_samples'[Sample Timestamp] = t
			        )
			    )
		formatString: 0.0000
		displayFolder: 09 Validation (5s)
		lineageTag: f00f6676-dcaf-515d-a179-85e37a175630

	measure 'Validated Error Display' = IF ( ISBLANK ( [Validated Error Latest] ), "Awaiting next laboratory result", FORMAT ( [Validated Error Latest], "0.000" ) & " %" )
		displayFolder: 09 Validation (5s)
		lineageTag: 11516aec-cbd5-523f-ad08-a657bab07dab

	measure 'Validated Error Caption' = IF ( ISBLANK ( [Validated Error Latest] ), "No validated comparison yet", "Validated at " & FORMAT ( [Validated Error Timestamp], "hh:nn" ) )
		displayFolder: 09 Validation (5s)
		lineageTag: 868ad94f-680e-584e-8f9f-e7aa889cfb2a

	measure 'Latest Anomaly Risk' =
			VAR t = [Latest Timestamp]
			RETURN
			    CALCULATE (
			        AVERAGE ( 'vw_dryer_dashboard_powerbi'[Anomaly Risk] ),
			        'vw_dryer_dashboard_powerbi'[Timestamp] = t
			    )
		formatString: 0.000
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 6b78267c-fdde-5200-a416-67d33482c6b6

	measure 'Risk Intensity' = COALESCE ( [Latest Anomaly Risk], 0 )
		formatString: 0.000
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 82d3a01b-71e8-5d95-b8bd-d4eb5a2a27fc

	measure 'Latest Anomaly Risk Display' = FORMAT ( [Risk Intensity], "0.00" )
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 28042c3f-bb84-5ff6-8a81-3fd112a56176

	measure 'Predicted Now Timestamp' =
			CALCULATE (
			    MAX ( 'vw_dryer_dashboard_powerbi'[Timestamp] ),
			    NOT ISBLANK ( 'vw_dryer_dashboard_powerbi'[Predicted Moisture] )
			)
		formatString: yyyy-mm-dd hh:nn:ss
		displayFolder: 10 Risk & Status (5s)
		lineageTag: d1cf8d88-9537-51e4-be50-2c5a83b5e048

	measure 'Predicted Now' =
			VAR t = [Predicted Now Timestamp]
			RETURN
			    IF (
			        ISBLANK ( t ),
			        BLANK (),
			        CALCULATE (
			            AVERAGE ( 'vw_dryer_dashboard_powerbi'[Predicted Moisture] ),
			            'vw_dryer_dashboard_powerbi'[Timestamp] = t
			        )
			    )
		formatString: 0.0000
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 38abdeaa-9df7-5e93-b584-cf8685d6a304

	measure 'Predicted Now Display' = IF ( ISBLANK ( [Predicted Now] ), "—", FORMAT ( [Predicted Now], "0.00" ) & " %" )
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 5c8a7f23-e84c-5244-9be1-a57dd7ef7d14

	measure 'Predicted Now Caption' = IF ( ISBLANK ( [Predicted Now Timestamp] ), "No prediction yet", "Updated " & FORMAT ( [Predicted Now Timestamp], "hh:nn:ss" ) )
		displayFolder: 10 Risk & Status (5s)
		lineageTag: ce3ca7d8-8039-59aa-b60d-664261596cf5

	measure 'Data Age Minutes (Now)' =
			IF (
			    ISBLANK ( [Latest Timestamp] ),
			    BLANK (),
			    DATEDIFF ( [Latest Timestamp], NOW (), SECOND ) / 60.0
			)
		formatString: 0.0
		displayFolder: 10 Risk & Status (5s)
		lineageTag: a556e7f3-7026-54f2-96a9-f9f3b11bcd14

	measure 'Ingest Age Minutes (Now)' =
			VAR t =
			    CALCULATE (
			        MAX ( 'vw_dryer_dashboard_powerbi'[Inference Timestamp] ),
			        REMOVEFILTERS ( 'vw_dryer_dashboard_powerbi' )
			    )
			RETURN
			    IF (
			        ISBLANK ( t ),
			        BLANK (),
			        DATEDIFF ( t, NOW (), SECOND ) / 60.0
			    )
		formatString: 0.0
		displayFolder: 10 Risk & Status (5s)
		lineageTag: d127fa3d-5816-57c3-9487-533840e2f325

	measure 'Freshness Status' =
			VAR age = [Ingest Age Minutes (Now)]
			RETURN
			    IF (
			        ISBLANK ( age ), "NO DATA",
			        IF ( age <= 2, "LIVE", IF ( age <= 10, "DELAYED", "STALE" ) )
			    )
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 365984fe-6a14-5b5a-b311-e3bba475231d

	measure 'Freshness Pill Label' = SWITCH ( [Freshness Status], "LIVE", "LIVE DATA", "DELAYED", "DELAYED", "STALE", "STALE", "NO DATA" )
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 854741e3-5594-5f5b-8466-0e7bcd527621

	measure 'Freshness Detail Display' = IF ( ISBLANK ( [Latest Timestamp] ), "no data received", "Latest " & FORMAT ( [Latest Timestamp], "yyyy-mm-dd hh:nn:ss" ) & " · ingested " & FORMAT ( [Ingest Age Minutes (Now)], "0" ) & " min ago" )
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 5c35c578-07f3-53cb-81ed-f0621b429dd2

	measure 'Refresh Pill Label' = "AUTO 60 SEC"
		displayFolder: 10 Risk & Status (5s)
		lineageTag: 05844ecd-d80a-56c6-86ec-a30a12e53049

	measure 'Operating Status' =
			VAR t = [Latest Timestamp]
			VAR latestStatus =
			    CALCULATE ( MAX ( 'vw_dryer_dashboard_powerbi'[Anomaly Status] ), 'vw_dryer_dashboard_powerbi'[Timestamp] = t )
			RETURN
			    IF (
			        [Freshness Status] = "STALE" || [Freshness Status] = "NO DATA",
			        "STALE",
			        IF (
			            latestStatus = "ANOMALY",
			            "ANOMALY",
			            IF ( [Risk Intensity] >= 0.35, "WATCH", "NORMAL" )
			        )
			    )
		displayFolder: 10 Risk & Status (5s)
		lineageTag: ede58d09-e918-520d-83a8-18d3320ad7a9

	measure 'Operating Status Caption' = SWITCH ( [Operating Status], "ANOMALY", "Requires verification", "WATCH", "Monitor closely", "STALE", "Data not current", "Stable operation" )
