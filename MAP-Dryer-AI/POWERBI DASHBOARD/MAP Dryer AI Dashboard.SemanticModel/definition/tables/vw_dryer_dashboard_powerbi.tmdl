		displayFolder: 02 Latest KPIs
		lineageTag: 22468c10-3e44-47de-b429-2d37eaf6ae82

	measure 'Latest Moisture Error' =
			VAR LatestTs = [Latest Timestamp]
			RETURN
			    CALCULATE (
