	/// No physical column for this on the live view; recomputed here from
	/// Predicted Moisture / Laboratory Moisture (mirrors the CASE expression
	/// in POWERBI DASHBOARD/sql/create_powerbi_views.sql).
	column 'Moisture Error' =
			IF (
			    ISBLANK ( 'vw_dryer_dashboard_powerbi'[Predicted Moisture] ) || ISBLANK ( 'vw_dryer_dashboard_powerbi'[Laboratory Moisture] ),
			    BLANK (),
			    'vw_dryer_dashboard_powerbi'[Predicted Moisture] - 'vw_dryer_dashboard_powerbi'[Laboratory Moisture]
			)
		formatString: +0.0000;-0.0000;0.0000
		lineageTag: 94295641-95c5-40f2-9c30-ab0ed44b6cd8
		summarizeBy: none

	column 'Absolute Moisture Error' =
			IF (
			    ISBLANK ( 'vw_dryer_dashboard_powerbi'[Predicted Moisture] ) || ISBLANK ( 'vw_dryer_dashboard_powerbi'[Laboratory Moisture] ),
			    BLANK (),
			    ABS ( 'vw_dryer_dashboard_powerbi'[Predicted Moisture] - 'vw_dryer_dashboard_powerbi'[Laboratory Moisture] )
			)
		formatString: 0.0000
