			    & " · mean " & FORMAT ( AVERAGE ( 'vw_dryer_dashboard_powerbi'[Air Flow Rate] ), "#,0" )
			    & " · σ " & FORMAT ( STDEV.P ( 'vw_dryer_dashboard_powerbi'[Air Flow Rate] ), "#,0" )
		displayFolder: 13 Critical Variables (5s)
		lineageTag: 90f7d7cc-0618-5935-9f81-bf5b1dbb4426

	measure 'Vacuum Status' =
			VAR v = [Latest Vacuum]
			RETURN
			    IF ( ISBLANK ( v ), "NO DATA",
			        IF ( v >= 46.2891 && v <= 49.9760, "NORMAL",
			            IF ( v >= 44.1563 && v <= 55.0516, "WATCH",
			                "HIGH" ) ) )
		displayFolder: 13 Critical Variables (5s)
		lineageTag: ab4e5a5a-a0b3-595c-bfbf-799c8c23c0dc

	measure 'Vacuum Card BG' =
			SWITCH ( [Vacuum Status],
			    "NORMAL", "#E7F4EF", "WATCH", "#FFF0D5",
			    "HIGH", "#FBE2E3", "#FFFFFF" )
		displayFolder: 11 Heatmap Colors (5s)
		lineageTag: 53fc4487-4c5a-5142-a689-ebd08b3c1c1c

	measure 'Vacuum Card FG' =
			SWITCH ( [Vacuum Status],
			    "NORMAL", "#087C5B", "WATCH", "#B26A00", "HIGH", "#C83F45",
			    "#66756F" )
		displayFolder: 11 Heatmap Colors (5s)
		lineageTag: 7f3f1933-35d0-5434-9c43-a4de9c73b62d

	measure 'Vacuum Value Display' = IF ( ISBLANK ( [Latest Vacuum] ), "—", FORMAT ( [Latest Vacuum], "0.0" ) & " mmH2O" )
		displayFolder: 13 Critical Variables (5s)
		lineageTag: b83d58f7-f984-56bb-960f-4adf61547e04

	measure 'Vacuum Delta 5m' =
			VAR t = [Latest Timestamp]
			VAR prev = t - TIME ( 0, 5, 0 )
			VAR previousValue =
			    CALCULATE (
			        AVERAGE ( 'vw_dryer_dashboard_powerbi'[Vacuum] ),
			        'vw_dryer_dashboard_powerbi'[Timestamp] = prev
			    )
			RETURN
			    IF (
			        ISBLANK ( previousValue ),
			        BLANK (),
			        [Latest Vacuum] - previousValue
			    )
		formatString: +0.00;-0.00;0.00
		displayFolder: 13 Critical Variables (5s)
		lineageTag: c958ad91-82ae-5baa-8de6-632eec915a80

	measure 'Vacuum Delta Display' =
			VAR d = [Vacuum Delta 5m]
			VAR deltaText =
			    IF (
			        ISBLANK ( d ),
			        "Δ —",
			        "Δ " & IF ( d >= 0, "+", "" ) & FORMAT ( d, "0.0" )
			    )
			RETURN
			    deltaText & "   " & [Vacuum Status]
		displayFolder: 13 Critical Variables (5s)
		lineageTag: ee17b6d9-10a7-5e8e-94b5-3feaf4dd8c0f

	measure 'Vacuum Stats Tooltip' =
			"min " & FORMAT ( MIN ( 'vw_dryer_dashboard_powerbi'[Vacuum] ), "0.0" )
			    & " · max " & FORMAT ( MAX ( 'vw_dryer_dashboard_powerbi'[Vacuum] ), "0.0" )
			    & " · mean " & FORMAT ( AVERAGE ( 'vw_dryer_dashboard_powerbi'[Vacuum] ), "0.0" )
			    & " · σ " & FORMAT ( STDEV.P ( 'vw_dryer_dashboard_powerbi'[Vacuum] ), "0.0" )
		displayFolder: 13 Critical Variables (5s)
		lineageTag: c96f9f5e-35e9-5828-94cf-db4afd495f8c
	/// ===== END 5S EXTENSION (generated) =====
	partition vw_dryer_dashboard_powerbi = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DB_Server, DB_Database),
				    Data = Source{[Schema = "public", Item = "vw_dryer_dashboard_powerbi"]}[Data]
