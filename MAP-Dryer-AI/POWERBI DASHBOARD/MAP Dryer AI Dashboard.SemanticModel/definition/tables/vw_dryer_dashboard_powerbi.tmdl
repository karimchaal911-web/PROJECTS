		displayFolder: 05 State Colors
		lineageTag: 06640233-9945-47d3-b9e7-627a921674cc

	/// ============================================================
	/// 06 Diagnostics Page (respond to the current filter context:
	/// with a single selected event they describe that event, else
	/// the most recent event inside the filtered window)
	/// ============================================================
	measure 'Selected Event Timestamp' = MAX ( 'vw_dryer_dashboard_powerbi'[Timestamp] )
		formatString: yyyy-mm-dd hh:nn:ss
		displayFolder: 06 Diagnostics Page
		lineageTag: b67a99b1-94f6-47e9-b592-a2a2594e4fa1

