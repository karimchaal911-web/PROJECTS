	measure 'Selected Laboratory Moisture Display' =
			VAR SelectedTs = MAX ( 'vw_dryer_dashboard_powerbi'[Timestamp] )
			VAR Result =
			    CALCULATE (
			        MAX ( 'vw_dryer_dashboard_powerbi'[Laboratory Moisture] ),
			        'vw_dryer_dashboard_powerbi'[Timestamp] = SelectedTs
			    )
			RETURN
			    IF ( ISBLANK ( Result ), "—", FORMAT ( Result, "0.0000" ) & " % H2O" )
		displayFolder: 06 Diagnostics Page
		lineageTag: 0e7a7ab3-d8f2-4581-a8d7-b8959f078129

	measure 'Selected Diagnosis' =
			VAR SelectedTs = MAX ( 'vw_dryer_dashboard_powerbi'[Timestamp] )
			VAR Result =
			    CALCULATE (
			        MAX ( 'vw_dryer_dashboard_powerbi'[Diagnosis] ),
			        'vw_dryer_dashboard_powerbi'[Timestamp] = SelectedTs
			    )
			RETURN
			    IF ( ISBLANK ( Result ), "—", Result )
		displayFolder: 06 Diagnostics Page
		lineageTag: daea2042-da9c-4f24-8f87-ddb81dc4a9ef

	measure 'Selected Possible Causes' =
			VAR SelectedTs = MAX ( 'vw_dryer_dashboard_powerbi'[Timestamp] )
			VAR Result =
			    CALCULATE (
			        MAX ( 'vw_dryer_dashboard_powerbi'[Possible Causes] ),
			        'vw_dryer_dashboard_powerbi'[Timestamp] = SelectedTs
			    )
			RETURN
			    IF ( ISBLANK ( Result ), "—", Result )
		displayFolder: 06 Diagnostics Page
		lineageTag: 06031e79-4fab-4e4b-9175-4757e81afa5e

	measure 'Selected Recommended Verification' =
			VAR SelectedTs = MAX ( 'vw_dryer_dashboard_powerbi'[Timestamp] )
			VAR Result =
			    CALCULATE (
			        MAX ( 'vw_dryer_dashboard_powerbi'[Recommended Verification] ),
			        'vw_dryer_dashboard_powerbi'[Timestamp] = SelectedTs
			    )
			RETURN
			    IF ( ISBLANK ( Result ), "—", Result )
		displayFolder: 06 Diagnostics Page
		lineageTag: 308409be-d61a-4f7f-ab06-f6c9f71ea870

	measure 'Selected Severity Color' =
			SWITCH (
			    UPPER ( [Selected Severity] ),
			    "NORMAL", "#00843D",
			    "LOW", "#E8A013",
			    "MEDIUM", "#E8A013",
			    "HIGH", "#C8102E",
			    "CRITICAL", "#C8102E",
			    "#8A9299"
			)
		displayFolder: 06 Diagnostics Page
		lineageTag: 697a40db-e329-446d-b0a0-9b7b771aa241

	/// Real model threshold: the One-Class SVM decision boundary. The
	/// realtime_pipeline flags an observation as anomalous exactly when the
	/// decision-function score is below zero. Not an invented limit.
	measure 'Anomaly Threshold' = 0.0
		formatString: 0.0
		displayFolder: 06 Diagnostics Page
		lineageTag: 93185825-c3bd-444b-b89a-cc55490255ad

	measure 'Anomaly Score (Anomalous)' =
			CALCULATE (
			    AVERAGE ( 'vw_dryer_dashboard_powerbi'[Anomaly Score] ),
			    KEEPFILTERS ( 'vw_dryer_dashboard_powerbi'[Anomaly Status] = "ANOMALY" )
			)
		formatString: 0.000000
		displayFolder: 06 Diagnostics Page
		lineageTag: 4249d9b8-df2a-46ec-8237-7c82e3fa8d31

	measure 'Predicted Moisture (Anomalous)' =
			CALCULATE (
			    AVERAGE ( 'vw_dryer_dashboard_powerbi'[Predicted Moisture] ),
			    KEEPFILTERS ( 'vw_dryer_dashboard_powerbi'[Anomaly Status] = "ANOMALY" )
			)
		formatString: 0.0000
		displayFolder: 06 Diagnostics Page
		lineageTag: 7fe9967c-4c2d-460c-b622-8b4cc6484b1a

	measure 'Anomaly Count' =
			CALCULATE (
			    COUNTROWS ( 'vw_dryer_dashboard_powerbi' ),
			    'vw_dryer_dashboard_powerbi'[Anomaly Status] = "ANOMALY"
			)
		formatString: #,0
		displayFolder: 06 Diagnostics Page
		lineageTag: bf0815a7-ba55-45e0-92f9-4d326a74fad0

	/// ============================================================
	/// 07 Chart Series (explicit measures so legends and table
	/// headers show clean names instead of "Average of ...")
	/// ============================================================
	measure 'Predicted Moisture (Model)' = AVERAGE ( 'vw_dryer_dashboard_powerbi'[Predicted Moisture] )
		formatString: 0.0000
		displayFolder: 07 Chart Series
		lineageTag: e38e40ef-8cbc-4833-8fd9-50866882a377

	measure 'Laboratory Moisture (Lab)' = AVERAGE ( 'vw_dryer_dashboard_powerbi'[Laboratory Moisture] )
		formatString: 0.0000
		displayFolder: 07 Chart Series
		lineageTag: 44f804c7-f583-4776-bd0f-339f038a3b7d

	measure 'Anomaly Score (Trend)' = AVERAGE ( 'vw_dryer_dashboard_powerbi'[Anomaly Score] )
		formatString: 0.000000
		displayFolder: 07 Chart Series
		lineageTag: f8ced9bb-881a-4124-8c05-a18406da0988

