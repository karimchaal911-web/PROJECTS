	partition vw_dryer_anomaly_events = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DB_Server, DB_Database),
				    Data = Source{[Schema = "public", Item = "vw_dryer_anomaly_events"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

